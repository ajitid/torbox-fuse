# Required; no default.
TORBOX_API_KEY=

# Defaults to `./torbox`.
MOUNT_PATH=./torbox

# Defaults to `./torbox-fuse.db`.
DATA_PATH=./torbox-fuse.db

# Defaults to `15s`. Standard Go durations are accepted (for example, `15s`, `2m`, `2h5s`).
# Checks TorBox for external library changes; detected changes refresh the mount.
MEDIA_CHANGE_CHECK_POLL_TIME=15s

# Defaults to `false`.
FUSE_ALLOW_OTHER=false

# Defaults to your OS cache directory plus `torbox-fuse`.
CACHE_PATH=

# Optional. When set, torbox-fuse asks Plex to scan `${MOUNT_PATH}/movies` and `${MOUNT_PATH}/series` at startup/manual refreshes and after external changes to the visible media view.
PLEX_ACCESS_TOKEN=

# Defaults to `http://127.0.0.1:32400`.
PLEX_BASE_URL=http://127.0.0.1:32400

# Optional. When set, torbox-fuse asks Jellyfin to refresh matching virtual folders at startup/manual refreshes and after external changes to the visible media view.
JELLYFIN_API_KEY=

# Defaults to `http://127.0.0.1:8096`.
JELLYFIN_BASE_URL=http://127.0.0.1:8096

# Defaults to `4747`.
WEBAPP_PORT=4747

# Defaults to `torrent`. Valid values: `torrent`, `usenet`, `webdl`. Comma-separated for multiple.
TORBOX_SOURCES=torrent
