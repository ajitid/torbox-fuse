# Required; no default.
TORBOX_API_KEY=

# Defaults to `./torbox`.
MOUNT_PATH=./torbox

# Defaults to `./torbox-fuse.db`.
DATA_PATH=./torbox-fuse.db

# Defaults to `normal`. Valid values: `slowest`, `very_slow`, `slow`, `normal`, `fast`, `ultra_fast`, `instant`.
MOUNT_REFRESH_TIME=normal

# Defaults to `false`.
FUSE_ALLOW_OTHER=false

# Defaults to your OS cache directory plus `torbox-fuse`.
CACHE_PATH=

# Defaults to `/tmp/torbox-fuse.sock`.
CONTROL_SOCKET_PATH=/tmp/torbox-fuse.sock
