# Required; no default.
TORBOX_API_KEY=

# Defaults to `./torbox`.
MOUNT_PATH=./torbox

# Defaults to `./torbox-fuse.db`.
DATA_PATH=./torbox-fuse.db

# Defaults to `3h`. Valid values: `24h`, `12h`, `6h`, `3h`, `1h`, `6min`.
MOUNT_REFRESH_TIME=3h

# Defaults to `false`.
FUSE_ALLOW_OTHER=false

# Defaults to your OS cache directory plus `torbox-fuse`.
CACHE_PATH=

# Optional. When set, torbox-fuse asks Plex to scan `${MOUNT_PATH}/movies` and `${MOUNT_PATH}/series` after successful mount refreshes.
PLEX_ACCESS_TOKEN=

# Defaults to `http://127.0.0.1:32400`.
PLEX_BASE_URL=http://127.0.0.1:32400

# Optional. When set, torbox-fuse asks Jellyfin to refresh virtual folders whose locations match `${MOUNT_PATH}/movies` or `${MOUNT_PATH}/series` after TorBox refreshes.
JELLYFIN_API_KEY=

# Defaults to `http://127.0.0.1:8096`.
JELLYFIN_BASE_URL=http://127.0.0.1:8096

# Defaults to `4747`.
WEBAPP_PORT=4747

# Defaults to `torrent`. Valid values: `torrent`, `usenet`, `webdl`. Comma-separated for multiple.
TORBOX_SOURCES=torrent
